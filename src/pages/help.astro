---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import { href } from '../data/nav.ts';
import { TG_HELP } from '../data/content.ts';

const entries = Object.entries(TG_HELP);
---
<BaseLayout title="Help — Tangerine" description="Guides and answers for getting the most out of the Tangerine suite.">
  <main>
    <section class="mk-page-hero">
      <div class="mk-page-hero__inner">
        <p class="tg-eyebrow">Help</p>
        <h1>How can we help?</h1>
        <p>Guides and answers for getting the most out of the Tangerine suite.</p>
      </div>
    </section>

    <section class="mk-section">
      <div class="mk-help-grid">
        {entries.map(([slug, art]) => (
          <a class="mk-card-link" href={href('help/' + slug)}>
            <Card interactive elevation="raised" class="mk-help">
              <h3>{art.title}</h3>
              <p>{art.summary}</p>
              <span class="mk-link">Learn more &rarr;</span>
            </Card>
          </a>
        ))}
      </div>
    </section>

    <section class="mk-cta">
      <h2>Can&rsquo;t find what you need?</h2>
      <p>Our team is happy to help with setup, customization, and rollout.</p>
      <Button as="a" href={href('contact')} variant="primary" size="lg">Contact support</Button>
    </section>
  </main>
</BaseLayout>
