---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Stat from '../components/Stat.astro';
import { href } from '../data/nav.ts';
import { STATS } from '../data/facts.ts';
import { HOME_PARTNERS } from '../data/home.ts';
---
<BaseLayout title="Impact — Tangerine" description="Tangerine has modernized reading and mathematics assessments in resource-constrained settings around the world.">
  <main>
    <section class="mk-page-hero mk-page-hero--brand">
      <div class="mk-page-hero__inner">
        <p class="tg-eyebrow" style="color:var(--gold-300)">Impact</p>
        <h1>Tangerine&rsquo;s local and global impact</h1>
        <p>Tangerine has modernized reading and mathematics assessments in resource-constrained settings around the world.</p>
      </div>
    </section>

    <section class="mk-section">
      <div class="mk-impact-grid">
        <Stat value={STATS.assessments.value} label="assessments & surveys conducted" gradient size="lg" />
        <Stat value={STATS.countries.value} label="countries" gradient size="lg" />
        <Stat value={STATS.organizations.value} label="organizations & researchers" gradient size="lg" />
        <Stat value={STATS.languages.value} label="languages" gradient size="lg" />
      </div>
    </section>

    <section class="mk-section mk-section--soft">
      <div class="mk-split">
        <img src="/assets/illustrations/global.png" alt="" class="mk-split__art" />
        <div>
          <h2>Modernizing assessment where it&rsquo;s needed most</h2>
          <p>Over a decade of proven performance, millions of successful assessments, and deployment across {STATS.countries.value} countries have established Tangerine as a trusted standard for reliable, versatile data collection — and it is open-source.</p>
          <p>Beyond academics, Tangerine facilitates non-cognitive assessments, inclusive education, and social-emotional learning. We&rsquo;re not just assessing knowledge; we&rsquo;re nurturing holistic development.</p>
          <Button as="a" href={href('user-stories')} variant="secondary">Read user stories</Button>
        </div>
      </div>
    </section>

    <section class="mk-section">
      <h2 class="mk-section__title">Trusted by a global community</h2>
      <div class="mk-partners">
        {HOME_PARTNERS.map((p) => (
          <div class="mk-partners__item"><img src={`/assets/partners/${p}.png`} alt={p} /></div>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
