---
import HelpArticleView from '../../views/HelpArticleView.astro';
import { TG_HELP } from '../../data/content.ts';

// One static article per help entry, in English.
export function getStaticPaths() {
  const slugs = Object.keys(TG_HELP);
  return slugs.map((slug, idx) => ({
    params: { slug },
    props: {
      art: (TG_HELP as any)[slug],
      next: slugs[(idx + 1) % slugs.length],
      nextTitle: (TG_HELP as any)[slugs[(idx + 1) % slugs.length]].title,
    },
  }));
}
const { art, next, nextTitle } = Astro.props as any;
---
<HelpArticleView locale="en" art={art} next={next} nextTitle={nextTitle} />
