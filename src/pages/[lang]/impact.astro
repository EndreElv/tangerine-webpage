---
import ImpactView from '../../views/ImpactView.astro';
import { LOCALES, type Locale } from '../../i18n/index.ts';

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== 'en').map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
---
<ImpactView locale={lang} />
