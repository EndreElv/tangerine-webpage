---
import HelpArticleView from '../../../views/HelpArticleView.astro';
import { LOCALES, type Locale } from '../../../i18n/index.ts';
import { getContent } from '../../../i18n/content/index.ts';

// /es/help/getting-started, … — one page per (locale × help article).
export function getStaticPaths() {
  const out: any[] = [];
  for (const lang of LOCALES.filter((l) => l !== 'en')) {
    const help = getContent(lang).help as any;
    const slugs = Object.keys(help);
    slugs.forEach((slug, idx) => {
      const nextSlug = slugs[(idx + 1) % slugs.length];
      out.push({ params: { lang, slug }, props: { art: help[slug], next: nextSlug, nextTitle: help[nextSlug].title } });
    });
  }
  return out;
}
const lang = Astro.params.lang as Locale;
const { art, next, nextTitle } = Astro.props as any;
---
<HelpArticleView locale={lang} art={art} next={next} nextTitle={nextTitle} />
