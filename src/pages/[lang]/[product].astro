---
import ProductView from '../../views/ProductView.astro';
import { LOCALES, type Locale } from '../../i18n/index.ts';
import { ROUTES } from '../../data/nav.ts';
import { getContent } from '../../i18n/content/index.ts';

// /es/tangerine, /fr/tangerine-teach, … — one page per (locale × product).
export function getStaticPaths() {
  const out: any[] = [];
  for (const lang of LOCALES.filter((l) => l !== 'en')) {
    for (const p of Object.values(getContent(lang).products) as any[]) {
      out.push({ params: { lang, product: ROUTES[p.key].replace(/^\//, '') }, props: { product: p } });
    }
  }
  return out;
}
const lang = Astro.params.lang as Locale;
const { product } = Astro.props as { product: any };
---
<ProductView locale={lang} product={product} />
