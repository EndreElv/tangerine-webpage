---
import ContactView from '../../views/ContactView.astro';
import { LOCALES, type Locale } from '../../i18n/index.ts';

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== 'en').map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
---
<ContactView locale={lang} />
