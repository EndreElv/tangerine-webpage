---
import ProductView from '../views/ProductView.astro';
import { ROUTES } from '../data/nav.ts';
import { TG_PRODUCTS } from '../data/content.ts';

// One static page per product (/tangerine, /tangerine-teach, …) in English.
export function getStaticPaths() {
  return Object.values(TG_PRODUCTS).map((p: any) => ({
    params: { product: ROUTES[p.key].replace(/^\//, '') },
    props: { product: p },
  }));
}
const { product } = Astro.props as { product: any };
---
<ProductView locale="en" product={product} />
