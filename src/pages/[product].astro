---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Badge from '../components/Badge.astro';
import { href, ROUTES } from '../data/nav.ts';
import { TG_PRODUCTS } from '../data/content.ts';

// One static page per product (/tangerine, /tangerine-teach, …), URL derived
// from the central route map. Ported from ui_kits/marketing-site/ProductPage.jsx.
export function getStaticPaths() {
  return Object.values(TG_PRODUCTS).map((p: any) => ({
    params: { product: ROUTES[p.key].replace(/^\//, '') },
    props: { product: p },
  }));
}
const { product: p } = Astro.props as { product: any };
---
<BaseLayout title={`${p.name} — Tangerine`} description={p.lead?.[0]}>
  <main>
    <div class="mk-breadcrumb">
      <a href={href('home')}>HOME</a> &gt; PRODUCTS &gt; <strong>{p.crumb}</strong>
    </div>

    <section class:list={['mk-prod-hero', { 'mk-prod-hero--tall': p.logoTall }]}>
      <img class="mk-prod-hero__logo" src={p.logo} alt={p.name} />
      <h1>{p.name}</h1>
      {p.badge && <div class="mk-prod-hero__badge"><Badge tone="accent" solid>{p.badge}</Badge></div>}
      {p.lead.map((t: string) => <p>{t}</p>)}
    </section>

    {p.blocks.map((block: any, i: number) => (
      <section class:list={['mk-section', { 'mk-section--soft': i % 2 === 0 }]}>
        {block.type === 'feature' && block.wide && (
          <div class="mk-wide-block">
            {block.eyebrow && <p class="tg-eyebrow" style="text-align:center">{block.eyebrow}</p>}
            <h2 class="mk-section__title">{block.heading}</h2>
            {block.body && block.body.map((para: string) => <p class="mk-section__lead">{para}</p>)}
            <Card elevation="raised" padded={false} class="mk-report">
              <img src={block.image} alt={block.heading} />
            </Card>
          </div>
        )}
        {block.type === 'feature' && !block.wide && (
          <div class:list={['mk-feature-row', { 'mk-feature-row--rev': block.reverse }]}>
            <div class="mk-feature-row__text">
              {block.eyebrow && <p class="tg-eyebrow">{block.eyebrow}</p>}
              <h2>{block.heading}</h2>
              {block.body.map((para: string) => <p>{para}</p>)}
              {block.cta && (
                <Button as="a" href={href(block.cta.to)} variant="primary">{block.cta.label}</Button>
              )}
            </div>
            <figure class="mk-feature-row__media">
              <Card elevation="raised" padded={false}>
                <img src={block.image} alt={block.heading} />
              </Card>
              {block.caption && <figcaption>{block.caption}</figcaption>}
            </figure>
          </div>
        )}
        {block.type === 'modules' && (
          <div class="mk-modules">
            {block.cards.map((m: any) => (
              <Card elevation="raised" media={m.img} mediaAlt={m.title} class="mk-module">
                <h3>{m.title}</h3>
                <p>{m.body}</p>
              </Card>
            ))}
          </div>
        )}
        {block.type === 'video' && (
          <div class="mk-video">
            <h2 class="mk-section__title">{block.heading}</h2>
            <div class="mk-video__frame">
              <iframe
                src={`https://www.youtube.com/embed/${block.id}`}
                title={block.heading}
                loading="lazy"
                frameborder="0"
                allowfullscreen
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              ></iframe>
            </div>
          </div>
        )}
      </section>
    ))}

    <section class="mk-cta">
      <h2>{p.cta.heading}</h2>
      <Button as="a" href={href(p.cta.to)} variant="accent" size="lg">{p.cta.label}</Button>
    </section>
  </main>
</BaseLayout>
