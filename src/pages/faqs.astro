---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { href } from '../data/nav.ts';
import { TG_FAQS } from '../data/content.ts';
---
<BaseLayout title="FAQs — Tangerine" description="Everything from device requirements to data, security, and support.">
  <main>
    <section class="mk-page-hero">
      <div class="mk-page-hero__inner">
        <p class="tg-eyebrow">FAQs</p>
        <h1>Frequently asked questions</h1>
        <p>Everything from device requirements to data, security, and support.</p>
      </div>
    </section>

    <section class="mk-section mk-section--narrow">
      {TG_FAQS.map((group, gi) => (
        <div class="mk-faq-group">
          <h2 class="mk-faq-group__title">{group.cat}</h2>
          <div class="mk-faqs">
            {group.items.map((item, ii) => (
              <details class="mk-faq" name="faq" open={gi === 0 && ii === 0}>
                <summary class="mk-faq__q">
                  <span>{item.q}</span>
                  <span class="mk-faq__icon" aria-hidden="true"></span>
                </summary>
                <div class="mk-faq__a">{item.a}</div>
              </details>
            ))}
          </div>
        </div>
      ))}
      <div class="mk-faqs__foot">
        <p>Still have questions?</p>
        <Button as="a" href={href('contact')} variant="secondary">Contact us</Button>
      </div>
    </section>
  </main>
</BaseLayout>
