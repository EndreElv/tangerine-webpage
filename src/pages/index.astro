---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Stat from '../components/Stat.astro';
import { href } from '../data/nav.ts';
import { STATS } from '../data/facts.ts';
import { HOME_PRODUCTS, HOME_FEATURES, HOME_PARTNERS, HOME_STORIES } from '../data/home.ts';
---
<BaseLayout>
  <main>
    {/* Hero */}
    <section class="mk-hero">
      <img class="mk-hero__bg" src="/assets/imagery/hero-overlay.png" alt="" />
      <div class="mk-hero__scrim"></div>
      <div class="mk-hero__content">
        <h1>Actionable insights,<br />anywhere.</h1>
        <p class="mk-hero__sub">Supporting education and innovation.</p>
        <p class="mk-hero__body">
          Tangerine® is transforming how education systems collect data, assess learning, and support
          teachers — especially in resource-constrained environments. Open-source and offline-first.
        </p>
        <Button as="a" href={href('trial')} variant="primary" size="lg">Get Tangerine</Button>
      </div>
    </section>

    {/* Product suite */}
    <section class="mk-section">
      <p class="tg-eyebrow" style="text-align:center">The Suite</p>
      <h2 class="mk-section__title">Tangerine® Product Suite</h2>
      <div class="mk-suite">
        {HOME_PRODUCTS.map((p) => (
          <Card elevation="raised" accentTop class="mk-suite__card">
            <img class="mk-suite__icon" src={p.icon} alt="" />
            <h3>{p.name}</h3>
            <ul class="mk-suite__list">
              {p.points.map((pt) => <li>{pt}</li>)}
            </ul>
            <a class="mk-link" href={href(p.to)}>Explore {p.name} →</a>
          </Card>
        ))}
      </div>
    </section>

    {/* Feature trio */}
    <section class="mk-section mk-section--soft">
      <div class="mk-features">
        {HOME_FEATURES.map((f) => (
          <div class="mk-feature">
            <img src={f.img} alt="" />
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
    </section>

    {/* Impact stats */}
    <section class="mk-impact">
      <h2 class="mk-section__title" style="color:#fff">Tangerine&rsquo;s local and global impact</h2>
      <div class="mk-impact__row">
        <Stat value={STATS.languages.value} label="languages" size="lg" />
        <Stat value={STATS.countries.value} label="countries worldwide" size="lg" />
        <Stat value={STATS.organizations.value} label="organizations" size="lg" />
      </div>
    </section>

    {/* User stories */}
    <section class="mk-section">
      <p class="tg-eyebrow" style="text-align:center">User Stories</p>
      <h2 class="mk-section__title">From the field</h2>
      <div class="mk-stories">
        {HOME_STORIES.map((s) => (
          <a class="mk-story-link" href={href('user-stories')}>
            <Card interactive elevation="raised" class="mk-story">
              <span class="mk-story__tag">{s.tag}</span>
              <h3>{s.title}</h3>
              <span class="mk-link">Continue Reading →</span>
            </Card>
          </a>
        ))}
      </div>
    </section>

    {/* Community */}
    <section class="mk-section mk-section--soft">
      <h2 class="mk-section__title">Tangerine® Community</h2>
      <div class="mk-partners">
        {HOME_PARTNERS.map((p) => (
          <div class="mk-partners__item">
            <img src={`/assets/partners/${p}.png`} alt={p} />
          </div>
        ))}
      </div>
    </section>

    {/* CTA */}
    <section class="mk-cta">
      <h2>Ready to try Tangerine?</h2>
      <p>Start a free trial today.</p>
      <Button as="a" href={href('trial')} variant="accent" size="lg">Get Started</Button>
    </section>
  </main>
</BaseLayout>

<style>
  .mk-story-link { display: block; text-decoration: none; color: inherit; }
  .mk-story-link:hover { text-decoration: none; }
</style>
