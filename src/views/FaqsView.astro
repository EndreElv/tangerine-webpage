---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { localizedHref } from '../data/nav.ts';
import { DEFAULT_LOCALE, type Locale } from '../i18n/index.ts';
import { PAGES } from '../i18n/pages.ts';
import { getContent } from '../i18n/content/index.ts';

interface Props { locale?: Locale }
const { locale = DEFAULT_LOCALE } = Astro.props;
const t = PAGES[locale];
const f = t.faqs;
const { faqs } = getContent(locale);
---
<BaseLayout title={t.meta.faqsTitle} description={t.meta.faqsDesc} locale={locale}>
  <main>
    <section class="mk-page-hero">
      <div class="mk-page-hero__inner">
        <p class="tg-eyebrow">{f.eyebrow}</p>
        <h1>{f.h1}</h1>
        <p>{f.sub}</p>
      </div>
    </section>

    <section class="mk-section mk-section--narrow">
      {faqs.map((group, gi) => (
        <div class="mk-faq-group">
          <h2 class="mk-faq-group__title">{group.cat}</h2>
          <div class="mk-faqs">
            {group.items.map((item, ii) => (
              <details class="mk-faq" name="faq" open={gi === 0 && ii === 0}>
                <summary class="mk-faq__q">
                  <span>{item.q}</span>
                  <span class="mk-faq__icon" aria-hidden="true"></span>
                </summary>
                <div class="mk-faq__a">{item.a}</div>
              </details>
            ))}
          </div>
        </div>
      ))}
      <div class="mk-faqs__foot">
        <p>{f.still}</p>
        <Button as="a" href={localizedHref('contact', locale)} variant="secondary">{f.contactUs}</Button>
      </div>
    </section>
  </main>
</BaseLayout>
