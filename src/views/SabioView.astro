---
// SABIO — Spanish-only product landing page for low-cost private schools in
// Latin America. Owl mascot as the star (first person). Recreated from the
// SABIO design handoff (SABIO.html + sections.jsx), adapted to the live site's
// tokens, components, Nav and Footer.
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import SabioOwl from '../components/SabioOwl.astro';
import SabioDashboard from '../components/SabioDashboard.astro';
import { localizedHref } from '../data/nav.ts';

const locale = 'es' as const;
const trial = localizedHref('trial', locale);
const contact = localizedHref('contact', locale);

const pillars = [
  {
    tag: 'Asistencia', cls: 'is-deep',
    title: 'Pasa lista en segundos',
    body: 'Registra la asistencia con un toque. SABIO detecta ausencias repetidas y te avisa antes de que un alumno empiece a desconectarse de la escuela.',
  },
  {
    tag: 'Comportamiento', cls: 'is-burnt',
    title: 'Registra logros e incidentes',
    body: 'Anota una nota positiva o un incidente al instante. SABIO encuentra los patrones que el día a día esconde y los convierte en señales claras.',
  },
  {
    tag: 'Evaluación formativa', cls: 'is-gold',
    title: 'Mide el aprendizaje sin perder clase',
    body: 'Evaluaciones rápidas que muestran quién avanza y quién necesita apoyo — sin exámenes largos ni semanas de espera para tener resultados.',
  },
];

const alerts = [
  ['Alerta de riesgo de deserción', 'cuando se cruzan ausencias y bajo desempeño'],
  ['Reporte semanal por grado', 'para el director, en un toque'],
  ['Resumen para las familias', 'claro, en su idioma, sin tecnicismos'],
];

const steps = [
  ['01', 'Registra', 'Tus docentes toman asistencia, anotan comportamiento y aplican evaluaciones rápidas desde una tablet.'],
  ['02', 'SABIO analiza', 'Aunque no haya internet, SABIO procesa los datos y busca señales de alerta en cada alumno.'],
  ['03', 'Recibe la alerta', 'Cuando algo necesita atención, SABIO te avisa con una recomendación concreta — no solo un número.'],
  ['04', 'Interviene a tiempo', 'Contactas a la familia o ajustas la enseñanza antes de que el alumno se atrase o abandone.'],
];

const letters = [
  ['S', 'Sistema'], ['A', 'de Apoyo'], ['B', 'Basado en'], ['I', 'Información'], ['O', 'Oportuna'],
];

const stats = [['5M+', 'Evaluaciones aplicadas'], ['65+', 'Países'], ['100+', 'Idiomas']];

const includes = [
  'Asistencia, comportamiento y evaluación',
  'Alertas tempranas y reportes',
  'Funciona sin internet',
  'Soporte en español',
  'Sin equipos nuevos: usa tus tablets',
];

const faqs = [
  ['¿Funciona sin conexión a internet?', 'Sí. SABIO es offline-first: tus docentes registran y trabajan sin internet, y los datos se sincronizan de forma segura cuando hay conexión.'],
  ['¿Necesito comprar tablets o equipos nuevos?', 'No. SABIO está optimizado para tablets y teléfonos Android de bajo costo que probablemente ya tengas. Funciona desde el navegador.'],
  ['¿Mis datos están seguros?', 'Sí. La soberanía y la seguridad de los datos son parte central de Tangerine. Tú decides dónde viven tus datos y quién puede verlos.'],
  ['¿En qué idiomas está disponible?', 'La interfaz está en español, y la plataforma Tangerine soporta más de 100 idiomas, incluidas lenguas locales y originarias.'],
  ['¿Cuánto cuesta para mi escuela?', 'El plan Escuela parte desde $1 USD por alumno al mes, con descuentos por volumen. Empieza con una prueba gratuita de 30 días.'],
  ['¿Es difícil de implementar?', 'No. Configuras un grado en minutos, capacitas a tus docentes en una sesión corta y SABIO empieza a generar alertas desde la primera semana.'],
];

const title = 'SABIO — Sistema de Apoyo Basado en Información Oportuna | Tangerine®';
const description = 'SABIO, tu búho atento: el sistema de apoyo docente que integra asistencia, comportamiento y evaluación formativa con alertas tempranas, para escuelas privadas de bajo costo en América Latina. Funciona sin internet.';
---
<BaseLayout title={title} description={description} locale={locale}>
  <main class="sabio-page">
    {/* ---------- HERO ---------- */}
    <section id="top" class="sb-hero">
      <div class="sb-hero__glow sb-hero__glow--a"></div>
      <div class="sb-hero__glow sb-hero__glow--b"></div>
      <div class="sb-hero__grid">
        <div>
          <div class="sb-hero__eyebrow">
            <span class="sb-hero__dot"></span>Nuevo · Para escuelas privadas de bajo costo
          </div>
          <h1 class="sb-hero__title">Soy <span>SABIO</span>,<br />tu búho atento.</h1>
          <p class="sb-hero__lead">
            Cuido la asistencia, el comportamiento y el aprendizaje de cada alumno — y te aviso <em>antes</em> de que sea tarde.
          </p>
          <p class="sb-hero__body">
            El sistema de apoyo docente que ayuda a las escuelas de América Latina a retener alumnos, demostrar resultados y ganarse la confianza de las familias. Funciona en cualquier tablet, incluso sin internet.
          </p>
          <div class="sb-hero__actions">
            <Button as="a" href={trial} variant="primary" size="lg">Prueba gratuita</Button>
            <a href="#como-funciona" class="sb-hero__play">
              <span class="sb-hero__play-ring">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="#fff"><path d="M8 5v14l11-7z" /></svg>
              </span>
              Ver cómo funciona
            </a>
          </div>
          <div class="sb-hero__suite">
            Parte de la suite <strong>Tangerine®</strong> · Sabiduría que transforma la educación
          </div>
        </div>
        <div class="sb-hero__owlwrap">
          <div class="sb-hero__owlring"></div>
          <SabioOwl size={300} float />
        </div>
      </div>
    </section>

    {/* ---------- THREE PILLARS ---------- */}
    <section class="sb-wrap sb-pillars">
      <div class="sb-head">
        <div class="tg-eyebrow">Tres miradas, un solo búho</div>
        <h2 class="sb-head__title">Todo lo que SABIO observa por ti</h2>
        <p class="sb-head__sub">Tres áreas que deciden si un alumno se queda o se va — reunidas en una sola herramienta sencilla para tus docentes.</p>
      </div>
      <div class="sb-pillars__grid">
        {pillars.map((p) => (
          <div class="sb-pillar">
            <div class:list={['sb-pillar__icon', p.cls]}>
              {p.tag === 'Asistencia' && (
                <svg width="26" height="26" viewBox="0 0 24 24"><path d="M4 11.5l5 5L20 5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
              )}
              {p.tag === 'Comportamiento' && (
                <svg width="26" height="26" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.4" stroke="currentColor" stroke-width="2.4" fill="none" /><path d="M5 20c0-3.9 3.1-7 7-7s7 3.1 7 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" fill="none" /></svg>
              )}
              {p.tag === 'Evaluación formativa' && (
                <svg width="26" height="26" viewBox="0 0 24 24"><path d="M4 5h16v13H4z" stroke="currentColor" stroke-width="2.4" fill="none" stroke-linejoin="round" /><path d="M8 10h8M8 14h5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
              )}
            </div>
            <div class:list={['sb-pillar__tag', p.cls]}>{p.tag}</div>
            <h3 class="sb-pillar__title">{p.title}</h3>
            <p class="sb-pillar__body">{p.body}</p>
          </div>
        ))}
      </div>
    </section>

    {/* ---------- ALERTS / REPORTING BAND ---------- */}
    <section class="sb-wrap sb-band-wrap">
      <div class="sb-band">
        <div>
          <div class="sb-band__eyebrow">Y lo conecta todo</div>
          <h2 class="sb-band__title">Alertas tempranas y reportes que sí se leen</h2>
          <p class="sb-band__body">
            SABIO cruza asistencia, comportamiento y aprendizaje para avisarte qué alumno necesita ayuda <strong>hoy</strong> — y entrega al director un reporte claro de cada grado, listo para compartir con las familias.
          </p>
        </div>
        <div class="sb-band__list">
          {alerts.map(([t, s]) => (
            <div class="sb-band__item">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="11" fill="rgba(255,255,255,0.22)" /><path d="M7 12.5l3 3L17 8.5" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <div><div class="sb-band__item-t">{t}</div><div class="sb-band__item-s">{s}</div></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ---------- HOW IT WORKS + DASHBOARD ---------- */}
    <section id="como-funciona" class="sb-hiw">
      <div class="sb-wrap">
        <div class="sb-head">
          <div class="tg-eyebrow">Cómo funciona</div>
          <h2 class="sb-head__title">De un toque a una decisión</h2>
        </div>
        <div class="sb-hiw__grid">
          <div class="sb-steps">
            {steps.map(([n, t, b], i) => (
              <div class="sb-step">
                <div class="sb-step__rail">
                  <div class="sb-step__num">{n}</div>
                  {i < steps.length - 1 && <div class="sb-step__line"></div>}
                </div>
                <div class="sb-step__text">
                  <h3 class="sb-step__title">{t}</h3>
                  <p class="sb-step__body">{b}</p>
                </div>
              </div>
            ))}
          </div>
          <div class="sb-hiw__dash">
            <SabioDashboard />
          </div>
        </div>
      </div>
    </section>

    {/* ---------- MASCOT STORY ---------- */}
    <section class="sb-story">
      <div class="sb-story__owl">
        <div class="sb-story__ring">
          <SabioOwl size={210} />
        </div>
      </div>
      <div>
        <div class="tg-eyebrow">Conóceme</div>
        <h2 class="sb-story__title">¿Por qué un búho?</h2>
        <p class="sb-story__lead">
          Porque el búho ve lo que otros no ven, está atento de día y de noche, y nunca pierde de vista a los suyos. Mi nombre lo dice todo:
        </p>
        <div class="sb-story__letters">
          {letters.map(([l, w]) => (
            <div class="sb-story__row">
              <span class="sb-story__letter">{l}</span>
              <span class="sb-story__word">{w}</span>
            </div>
          ))}
        </div>
        <p class="sb-story__foot">
          Y, claro, <strong>SABIO</strong> también quiere decir sabio. Esa es mi promesa: convertir cada dato que tus docentes registran en sabiduría útil para tu escuela.
        </p>
      </div>
    </section>

    {/* ---------- IMPACT ---------- */}
    <section class="sb-impact">
      <div class="sb-wrap">
        <div class="sb-impact__head">
          <div class="sb-impact__eyebrow">Respaldo comprobado</div>
          <h2 class="sb-impact__title">Construido sobre la tecnología de Tangerine®</h2>
          <p class="sb-impact__sub">SABIO se apoya en la plataforma que ya transformó la recolección de datos educativos en todo el mundo.</p>
        </div>
        <div class="sb-impact__row">
          {stats.map(([v, l]) => (
            <div class="sb-impact__stat">
              <div class="sb-impact__v">{v}</div>
              <div class="sb-impact__l">{l}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ---------- TESTIMONIAL (placeholder) ---------- */}
    <section class="sb-testi-wrap">
      <div class="sb-testi">
        <div class="sb-testi__quote">“</div>
        <p class="sb-testi__text">[Espacio para el testimonio de una escuela. Por ejemplo: cómo SABIO ayudó a reducir la deserción y a tener conversaciones más útiles con las familias.]</p>
        <div class="sb-testi__by">
          <div class="sb-testi__photo">FOTO</div>
          <div>
            <div class="sb-testi__name">[Nombre del director(a)]</div>
            <div class="sb-testi__meta">[Escuela] · [Ciudad, país]</div>
          </div>
        </div>
      </div>
    </section>

    {/* ---------- PRICING TEASER ---------- */}
    <section class="sb-wrap sb-pricing">
      <div class="sb-head">
        <div class="tg-eyebrow">Pensado para escuelas de bajo costo</div>
        <h2 class="sb-head__title">Un precio que cabe en tu presupuesto</h2>
        <p class="sb-head__sub">Sin licencias caras ni instalaciones complicadas. Pagas por alumno, solo por lo que usas.</p>
      </div>
      <div class="sb-price">
        <div class="sb-price__plan">
          <div class="sb-price__label">Plan Escuela</div>
          <div class="sb-price__amount">
            <span class="sb-price__from">desde</span>
            <span class="sb-price__big">$1</span>
            <span class="sb-price__unit">USD / alumno · mes</span>
          </div>
          <p class="sb-price__note">Precio referencial. Descuentos por volumen y por ciclo escolar.</p>
          <ul class="sb-price__list">
            {includes.map((i) => (
              <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="var(--tangerine-100)" /><path d="M8 12l2.5 2.5L16 9" stroke="var(--tangerine-500)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                {i}
              </li>
            ))}
          </ul>
        </div>
        <div class="sb-price__trial">
          <SabioOwl size={84} style="margin-bottom:18px;" />
          <h3 class="sb-price__trial-title">Pruébame 30 días gratis</h3>
          <p class="sb-price__trial-body">Sin tarjeta. Configura un grado, mira las primeras alertas y decide después.</p>
          <Button as="a" href={trial} size="lg" class="sb-btn-white">Prueba gratuita</Button>
          <a href={contact} class="sb-price__sales">Hablar con ventas →</a>
        </div>
      </div>
    </section>

    {/* ---------- FAQ ---------- */}
    <section class="sb-faq">
      <div class="sb-faq__inner">
        <div class="sb-head">
          <div class="tg-eyebrow">Preguntas frecuentes</div>
          <h2 class="sb-head__title">Lo que los directores preguntan</h2>
        </div>
        <div class="sb-faq__list">
          {faqs.map(([q, a], i) => (
            <details class="sb-faq__item" open={i === 0}>
              <summary class="sb-faq__q">
                <span>{q}</span>
                <svg class="sb-faq__icon" width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
              </summary>
              <div class="sb-faq__a">{a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* ---------- FINAL CTA ---------- */}
    <section class="sb-wrap sb-cta-wrap">
      <div class="sb-cta">
        <div class="sb-cta__owl"><SabioOwl size={240} blink={false} /></div>
        <div class="sb-cta__inner">
          <h2 class="sb-cta__title">Dale a tu escuela el búho que nunca se distrae</h2>
          <p class="sb-cta__sub">Empieza gratis hoy. Sin tarjeta, sin instalaciones.</p>
          <div class="sb-cta__actions">
            <Button as="a" href={trial} variant="primary" size="lg">Prueba gratuita</Button>
            <Button as="a" href={contact} variant="ghost" size="lg" class="sb-btn-ghost">Contáctanos</Button>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .sabio-page { background: var(--surface-card); }
  .sb-wrap { max-width: 1200px; margin: 0 auto; padding-left: 28px; padding-right: 28px; }
  .sb-head { text-align: center; margin-bottom: 46px; }
  .sb-head__title { font-size: 40px; margin: 8px 0 14px; color: var(--text-strong); }
  .sb-head__sub { font-size: 17px; color: var(--text-muted); max-width: 620px; margin: 0 auto; line-height: 1.55; }

  /* Hero */
  .sb-hero { position: relative; overflow: hidden; background: var(--surface-inverse); }
  .sb-hero__glow { position: absolute; border-radius: 50%; pointer-events: none; }
  .sb-hero__glow--a { top: -30%; right: -10%; width: 720px; height: 720px; background: radial-gradient(circle, rgba(240,84,36,0.55) 0%, rgba(240,84,36,0) 65%); }
  .sb-hero__glow--b { bottom: -40%; left: -15%; width: 620px; height: 620px; background: radial-gradient(circle, rgba(252,180,12,0.30) 0%, rgba(252,180,12,0) 65%); }
  .sb-hero__grid { position: relative; max-width: 1200px; margin: 0 auto; padding: 64px 28px 72px; display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 48px; align-items: center; }
  .sb-hero__eyebrow { display: inline-flex; align-items: center; gap: 9px; font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--gold-400); margin-bottom: 18px; }
  .sb-hero__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--gold-400); }
  .sb-hero__title { font-size: 56px; line-height: 1.04; letter-spacing: -0.02em; color: #fff; margin: 0 0 12px; font-weight: 900; }
  .sb-hero__title span { color: var(--gold-400); }
  .sb-hero__lead { font-size: 21px; line-height: 1.45; color: rgba(255,255,255,0.94); max-width: 540px; margin: 0 0 16px; font-weight: 500; }
  .sb-hero__lead em { color: var(--gold-400); font-style: normal; font-weight: 700; }
  .sb-hero__body { font-size: 15.5px; line-height: 1.6; color: rgba(255,255,255,0.78); max-width: 520px; margin: 0 0 30px; }
  .sb-hero__actions { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }
  .sb-hero__play { display: inline-flex; align-items: center; gap: 9px; color: #fff; font-weight: 700; font-size: 15.5px; }
  .sb-hero__play:hover { text-decoration: none; }
  .sb-hero__play-ring { width: 40px; height: 40px; border-radius: 50%; border: 1.5px solid rgba(255,255,255,0.5); display: grid; place-items: center; }
  .sb-hero__suite { margin-top: 30px; font-size: 13px; color: rgba(255,255,255,0.6); font-weight: 600; letter-spacing: .03em; }
  .sb-hero__suite strong { color: rgba(255,255,255,0.85); }
  .sb-hero__owlwrap { display: grid; place-items: center; }
  .sb-hero__owlwrap > :global(.sabio-owl) { position: relative; }
  .sb-hero__owlring { position: absolute; width: 360px; height: 360px; border-radius: 50%; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); }

  /* Pillars */
  .sb-pillars { padding-top: 84px; padding-bottom: 40px; }
  .sb-pillars__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .sb-pillar { background: #fff; border-radius: 16px; border: 1px solid var(--border-subtle); padding: 28px; box-shadow: var(--shadow-sm); transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out); }
  .sb-pillar:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .sb-pillar__icon { width: 54px; height: 54px; border-radius: 14px; background: var(--tangerine-50); display: grid; place-items: center; margin-bottom: 18px; }
  .sb-pillar__tag { font-size: 12.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 7px; }
  .is-deep { color: var(--tangerine-500); }
  .is-burnt { color: var(--tangerine-700); }
  .is-gold { color: var(--gold-500); }
  .sb-pillar__title { font-size: 21px; margin: 0 0 10px; color: var(--text-strong); }
  .sb-pillar__body { font-size: 15px; line-height: 1.6; color: var(--text-body); margin: 0; }

  /* Alerts band */
  .sb-band-wrap { padding-top: 24px; padding-bottom: 8px; }
  .sb-band { background: var(--gradient-brand); border-radius: 24px; padding: 40px 44px; color: #fff; display: grid; grid-template-columns: 1fr 1fr; gap: 36px; align-items: center; }
  .sb-band__eyebrow { font-size: 12.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .07em; opacity: 0.92; margin-bottom: 10px; }
  .sb-band__title { font-size: 30px; color: #fff; margin: 0 0 12px; line-height: 1.15; }
  .sb-band__body { font-size: 16px; line-height: 1.6; color: rgba(255,255,255,0.92); margin: 0; }
  .sb-band__list { display: flex; flex-direction: column; gap: 12px; }
  .sb-band__item { display: flex; gap: 13px; align-items: center; background: rgba(255,255,255,0.14); border-radius: 12px; padding: 13px 16px; }
  .sb-band__item svg { flex: none; }
  .sb-band__item-t { font-weight: 700; font-size: 15px; }
  .sb-band__item-s { font-size: 13px; opacity: 0.85; }

  /* How it works */
  .sb-hiw { background: var(--surface-page); border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle); }
  .sb-hiw .sb-wrap { padding-top: 84px; padding-bottom: 84px; }
  .sb-hiw .sb-head { margin-bottom: 50px; }
  .sb-hiw__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .sb-steps { display: flex; flex-direction: column; gap: 8px; }
  .sb-step { display: flex; gap: 18px; }
  .sb-step__rail { display: flex; flex-direction: column; align-items: center; }
  .sb-step__num { width: 46px; height: 46px; border-radius: 50%; background: var(--surface-inverse); color: var(--gold-400); font-family: var(--font-mono); font-weight: 700; font-size: 16px; display: grid; place-items: center; flex: none; }
  .sb-step__line { width: 2px; flex: 1; min-height: 22px; background: var(--border-subtle); margin: 6px 0; }
  .sb-step__text { padding-bottom: 18px; }
  .sb-step__title { font-size: 19px; margin: 8px 0 5px; color: var(--text-strong); }
  .sb-step__body { font-size: 14.5px; line-height: 1.55; color: var(--text-muted); margin: 0; max-width: 380px; }
  .sb-hiw__dash { display: grid; place-items: center; }

  /* Mascot story */
  .sb-story { max-width: 1040px; margin: 0 auto; padding: 88px 28px; display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 48px; align-items: center; }
  .sb-story__owl { display: grid; place-items: center; }
  .sb-story__ring { width: 280px; height: 280px; border-radius: 50%; background: var(--gradient-sunrise); display: grid; place-items: center; box-shadow: var(--shadow-brand); }
  .sb-story__title { font-size: 36px; margin: 8px 0 16px; color: var(--text-strong); }
  .sb-story__lead { font-size: 17px; line-height: 1.6; color: var(--text-body); margin: 0 0 22px; }
  .sb-story__letters { display: flex; flex-direction: column; gap: 9px; margin-bottom: 22px; }
