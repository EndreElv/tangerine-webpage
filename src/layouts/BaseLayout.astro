---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { LANG_ATTR, dir, DEFAULT_LOCALE, type Locale } from '../i18n/index.ts';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}
const {
  title = 'Tangerine® — Actionable insights, anywhere.',
  description = 'Tangerine® is an open-source, offline-first platform for data collection in education — assessments, surveys, and monitoring that work anywhere, even without connectivity.',
  locale = DEFAULT_LOCALE,
} = Astro.props;
---

<!doctype html>
<html lang={LANG_ATTR[locale]} dir={dir(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/assets/product-icons/tangerine.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/assets/imagery/hero-overlay.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    {/* First-visit language routing. Only redirects from the site root, only
        when the visitor has no saved preference, and only once per session —
        so it never fights a deliberate choice or a deep link. */}
    <script is:inline>
      (function () {
        try {
          var supported = ['es', 'fr', 'ar'];
          var path = location.pathname.replace(/\/+$/, '') || '/';
          var seg = path.split('/').filter(Boolean)[0];
          var current = supported.indexOf(seg) >= 0 ? seg : 'en';
          var atRoot = path === '/' || supported.indexOf(seg) >= 0 && path === '/' + seg;
          if (!atRoot) return;

          var saved = localStorage.getItem('tg-lang');
          if (saved) {
            // Returning visitor with a saved choice: honor it on the root.
            if (saved !== current) {
              location.replace(saved === 'en' ? '/' : '/' + saved);
            }
            return;
          }
          if (sessionStorage.getItem('tg-auto')) return;
          sessionStorage.setItem('tg-auto', '1');

          var prefs = navigator.languages || [navigator.language || 'en'];
          var pick = 'en';
          for (var i = 0; i < prefs.length; i++) {
            var code = String(prefs[i]).toLowerCase().split('-')[0];
            if (code === 'en') break;
            if (supported.indexOf(code) >= 0) { pick = code; break; }
          }
          if (pick !== current) {
            location.replace(pick === 'en' ? '/' : '/' + pick);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="mk-app">
      <Nav locale={locale} />
      <slot />
      <Footer locale={locale} />
    </div>
  </body>
</html>
