---
// SABIO — the owl mascot. Uses the official brand artwork (brown owl with
// tangerine citrus-slice eyes on a leafy branch) and overlays animated eyelids
// so SABIO blinks. Eye centres measured from the source art:
//   left (211,198) · right (403,198) · flesh radius ~96 · viewBox 615×615.
// Ported from the SABIO design handoff (owl.jsx).
interface Props {
  size?: number;
  float?: boolean;
  blink?: boolean;
  class?: string;
  style?: string;
}
const { size = 220, float = false, blink = true, class: className, style = '' } = Astro.props;
const W = 615;
const R = 99; // lid radius (covers flesh, tucks under the cream rim)
const eyes = [
  { id: 'L', cx: 211, cy: 198 },
  { id: 'R', cx: 403, cy: 198 },
];
// Unique id suffix so multiple owls on one page don't share clip/gradient ids.
const uid = Math.random().toString(36).slice(2, 8);
---
<div
  class:list={['sabio-owl', { 'sabio-float': float }, className]}
  style={`position:relative;width:${size}px;height:${size}px;${style}`}
  role="img"
  aria-label="SABIO, el búho"
>
  <img
    src="/assets/sabio/sabio-owl.png"
    alt=""
    style="width:100%;height:100%;display:block;object-fit:contain;"
  />
  <svg
    viewBox={`0 0 ${W} ${W}`}
    style="position:absolute;inset:0;width:100%;height:100%;overflow:visible;"
    aria-hidden="true"
  >
    <defs>
      {eyes.map((e) => (
        <clipPath id={`sabioEye${e.id}-${uid}`}>
          <circle cx={e.cx} cy={e.cy} r={R} />
        </clipPath>
      ))}
      <linearGradient id={`sabioLid-${uid}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#C2702C" />
        <stop offset="100%" stop-color="#9C5320" />
      </linearGradient>
    </defs>
    {blink && eyes.map((e) => (
      <g clip-path={`url(#sabioEye${e.id}-${uid})`}>
        <g class="sabio-lid">
          <circle cx={e.cx} cy={e.cy} r={R} fill={`url(#sabioLid-${uid})`} />
          {/* sleepy lower lash crease */}
          <path
            d={`M${e.cx - R + 6} ${e.cy + 14} q${R - 6} 54 ${2 * R - 12} 0`}
            fill="none"
            stroke="#5A3416"
            stroke-width="7"
            stroke-linecap="round"
          />
        </g>
      </g>
    ))}
  </svg>
</div>

<style is:global>
  @keyframes sabioFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-14px); } }
  .sabio-float { animation: sabioFloat 4.5s var(--ease-out) infinite; }
  @keyframes sabioBlink {
    0%, 90% { transform: scaleY(0); }
    94%, 95.5% { transform: scaleY(1); }
    99%, 100% { transform: scaleY(0); }
  }
  .sabio-lid {
    transform-box: fill-box;
    transform-origin: center top;
    animation: sabioBlink 5.5s var(--ease-out) infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .sabio-float, .sabio-lid { animation: none; }
    .sabio-lid { transform: scaleY(0); }
  }
</style>
